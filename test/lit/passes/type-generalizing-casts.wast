;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --type-generalizing       -tnh -all -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt --type-generalizing-casts -tnh -all -S -o - | filecheck %s --check-prefix=CASTS

(module
  (type $A (sub (struct)))


  ;; CHECK:      (type $0 (func (param structref) (result anyref)))

  ;; CHECK:      (func $test (type $0) (param $ref structref) (result anyref)
  ;; CHECK-NEXT:  (local $temp anyref)
  ;; CHECK-NEXT:  (local.set $temp
  ;; CHECK-NEXT:   (ref.cast structref
  ;; CHECK-NEXT:    (local.get $ref)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $temp)
  ;; CHECK-NEXT: )
  ;; CASTS:      (type $0 (func (param structref) (result anyref)))

  ;; CASTS:      (func $test (type $0) (param $ref structref) (result anyref)
  ;; CASTS-NEXT:  (local $temp structref)
  ;; CASTS-NEXT:  (local.set $temp
  ;; CASTS-NEXT:   (ref.cast structref
  ;; CASTS-NEXT:    (local.get $ref)
  ;; CASTS-NEXT:   )
  ;; CASTS-NEXT:  )
  ;; CASTS-NEXT:  (local.get $temp)
  ;; CASTS-NEXT: )
  (func $local (param $ref structref) (result anyref)
    ;; Normally we can generalize the local to anyref. In casts mode, we only
    ;; refine it enough for the cast to be removable (later), to structref.
    (local $temp (ref $A))
    (local.set $temp
      (ref.cast (ref $A)
        (local.get $ref)
      )
    )
    (local.get $temp)
  )

  (func $local (param $ref structref) (result anyref)
    ;; As above, but without a cast. We do not refine at all in casts mode.
    (local $temp (ref $A))
    (local.set $temp
      (ref.cast (ref $A)
        (local.get $ref)
      )
    )
    (local.get $temp)
  )
)

