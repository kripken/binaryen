;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Check that casts to exact types constrain their inputs to the same exact heap
;; XXX
;; type when custom descriptors are disabled, since non-trivial exact casts
;; require custom descriptors. (Without CD, we allow only trivial exact casts,
;; so we would not validate if we generalized a type in a way that made a
;; previously exact-and-trivial cast into an exact-and-*non*trivial cast.)

;; RUN: foreach %s %t wasm-opt --experimental-type-generalizing -all                              -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt --experimental-type-generalizing -all --disable-custom-descriptors -S -o - | filecheck %s --check-prefix=NO_CD

(module
 ;; CHECK:      (type $foo (sub (struct)))
 ;; NO_CD:      (type $foo (sub (struct)))
 (type $foo (sub (struct)))

 ;; CHECK:      (type $bar (sub $foo (struct)))
 ;; NO_CD:      (type $bar (sub $foo (struct)))
 (type $bar (sub $foo (struct)))

 ;; CHECK:      (type $2 (func (param (ref (exact $foo))) (result anyref)))

 ;; CHECK:      (type $3 (func (param (ref (exact $foo))) (result i32)))

 ;; CHECK:      (type $4 (func (param (ref (exact $foo)))))

 ;; CHECK:      (type $5 (func (param (ref (exact $bar))) (result (ref $foo))))

 ;; CHECK:      (func $ref.test (type $3) (param $exact (ref (exact $foo))) (result i32)
 ;; CHECK-NEXT:  (local $x anyref)
 ;; CHECK-NEXT:  (local.set $x
 ;; CHECK-NEXT:   (local.get $exact)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (ref.test (ref (exact $foo))
 ;; CHECK-NEXT:   (local.get $x)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 ;; NO_CD:      (type $2 (func (param (ref (exact $foo))) (result anyref)))

 ;; NO_CD:      (type $3 (func (param (ref (exact $foo))) (result i32)))

 ;; NO_CD:      (type $4 (func (param (ref (exact $foo)))))

 ;; NO_CD:      (type $5 (func (param (ref (exact $bar))) (result (ref $foo))))

 ;; NO_CD:      (func $ref.test (type $3) (param $exact (ref (exact $foo))) (result i32)
 ;; NO_CD-NEXT:  (local $x (ref (exact $foo)))
 ;; NO_CD-NEXT:  (local.set $x
 ;; NO_CD-NEXT:   (local.get $exact)
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT:  (ref.test (ref (exact $foo))
 ;; NO_CD-NEXT:   (local.get $x)
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT: )
 (func $ref.test (param $exact (ref (exact $foo))) (result i32)
  (local $x (ref (exact $foo)))
  (local.set $x
   (local.get $exact)
  )
  (ref.test (ref (exact $foo))
   (local.get $x)
  )
 )

 ;; CHECK:      (func $ref.cast (type $4) (param $exact (ref (exact $foo)))
 ;; CHECK-NEXT:  (local $x anyref)
 ;; CHECK-NEXT:  (local.set $x
 ;; CHECK-NEXT:   (local.get $exact)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.cast (ref (exact $foo))
 ;; CHECK-NEXT:    (local.get $x)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 ;; NO_CD:      (func $ref.cast (type $4) (param $exact (ref (exact $foo)))
 ;; NO_CD-NEXT:  (local $x (ref (exact $foo)))
 ;; NO_CD-NEXT:  (local.set $x
 ;; NO_CD-NEXT:   (local.get $exact)
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT:  (drop
 ;; NO_CD-NEXT:   (ref.cast (ref (exact $foo))
 ;; NO_CD-NEXT:    (local.get $x)
 ;; NO_CD-NEXT:   )
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT: )
 (func $ref.cast (param $exact (ref (exact $foo)))
  (local $x (ref (exact $foo)))
  (local.set $x
   (local.get $exact)
  )
  (drop
   (ref.cast (ref (exact $foo))
    (local.get $x)
   )
  )
 )

 ;; CHECK:      (func $br_on_cast (type $2) (param $exact (ref (exact $foo))) (result anyref)
 ;; CHECK-NEXT:  (local $x (ref (exact $foo)))
 ;; CHECK-NEXT:  (local.set $x
 ;; CHECK-NEXT:   (local.get $exact)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (block $block (result anyref)
 ;; CHECK-NEXT:   (drop
 ;; CHECK-NEXT:    (br_on_cast $block (ref (exact $foo)) (ref (exact $foo))
 ;; CHECK-NEXT:     (local.get $x)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (ref.null none)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 ;; NO_CD:      (func $br_on_cast (type $2) (param $exact (ref (exact $foo))) (result anyref)
 ;; NO_CD-NEXT:  (local $x (ref (exact $foo)))
 ;; NO_CD-NEXT:  (local.set $x
 ;; NO_CD-NEXT:   (local.get $exact)
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT:  (block $block (result anyref)
 ;; NO_CD-NEXT:   (drop
 ;; NO_CD-NEXT:    (br_on_cast $block (ref (exact $foo)) (ref (exact $foo))
 ;; NO_CD-NEXT:     (local.get $x)
 ;; NO_CD-NEXT:    )
 ;; NO_CD-NEXT:   )
 ;; NO_CD-NEXT:   (ref.null none)
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT: )
 (func $br_on_cast (param $exact (ref (exact $foo))) (result anyref)
  (local $x (ref (exact $foo)))
  (local.set $x
   (local.get $exact)
  )
  (block $block (result anyref)
   (drop
    (br_on_cast $block (ref (exact $foo)) (ref (exact $foo))
     (local.get $x)
    )
   )
   (ref.null none)
  )
 )

 ;; CHECK:      (func $br_on_cast_fail (type $2) (param $exact (ref (exact $foo))) (result anyref)
 ;; CHECK-NEXT:  (local $x anyref)
 ;; CHECK-NEXT:  (local.set $x
 ;; CHECK-NEXT:   (local.get $exact)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (block $block (result anyref)
 ;; CHECK-NEXT:   (drop
 ;; CHECK-NEXT:    (br_on_cast_fail $block anyref (ref (exact $foo))
 ;; CHECK-NEXT:     (local.get $x)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (ref.null none)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 ;; NO_CD:      (func $br_on_cast_fail (type $2) (param $exact (ref (exact $foo))) (result anyref)
 ;; NO_CD-NEXT:  (local $x (ref (exact $foo)))
 ;; NO_CD-NEXT:  (local.set $x
 ;; NO_CD-NEXT:   (local.get $exact)
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT:  (block $block (result anyref)
 ;; NO_CD-NEXT:   (drop
 ;; NO_CD-NEXT:    (br_on_cast_fail $block (ref (exact $foo)) (ref (exact $foo))
 ;; NO_CD-NEXT:     (local.get $x)
 ;; NO_CD-NEXT:    )
 ;; NO_CD-NEXT:   )
 ;; NO_CD-NEXT:   (ref.null none)
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT: )
 (func $br_on_cast_fail (param $exact (ref (exact $foo))) (result anyref)
  (local $x (ref (exact $foo)))
  (local.set $x
   (local.get $exact)
  )
  (block $block (result anyref)
   (drop
    (br_on_cast_fail $block (ref null (exact $foo)) (ref null (exact $foo))
     (local.get $x)
    )
   )
   (ref.null none)
  )
 )

 ;; CHECK:      (func $nonbasic (type $5) (param $bar (ref (exact $bar))) (result (ref $foo))
 ;; CHECK-NEXT:  (local $x (ref $foo))
 ;; CHECK-NEXT:  (local.set $x
 ;; CHECK-NEXT:   (local.get $bar)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (drop
 ;; CHECK-NEXT:   (ref.cast (ref (exact $bar))
 ;; CHECK-NEXT:    (local.get $x)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT:  (local.get $x)
 ;; CHECK-NEXT: )
 ;; NO_CD:      (func $nonbasic (type $5) (param $bar (ref (exact $bar))) (result (ref $foo))
 ;; NO_CD-NEXT:  (local $x (ref (exact $bar)))
 ;; NO_CD-NEXT:  (local.set $x
 ;; NO_CD-NEXT:   (local.get $bar)
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT:  (drop
 ;; NO_CD-NEXT:   (ref.cast (ref (exact $bar))
 ;; NO_CD-NEXT:    (local.get $x)
 ;; NO_CD-NEXT:   )
 ;; NO_CD-NEXT:  )
 ;; NO_CD-NEXT:  (local.get $x)
 ;; NO_CD-NEXT: )
 (func $nonbasic (param $bar (ref (exact $bar))) (result (ref $foo))
  (local $x (ref (exact $bar)))
  ;; $x can be generalized to $foo, but must remain exact because of the cast.
  (local.set $x
   (local.get $bar)
  )
  (drop
   (ref.cast (ref $foo)
    (local.get $x)
   )
  )
  (local.get $x)
 )
)
