;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; local-generalizing runs by default in the last set of opts, and at a time
;; that allows local-coalescing to benefit.

;; TODO: rename test filenames

;; RUN: foreach %s %t wasm-opt --expect-later-toolchain-opts -O2 -all -S -o - | filecheck %s --check-prefix=PREV
;; RUN: foreach %s %t wasm-opt                               -O2 -all -S -o - | filecheck %s --check-prefix=LAST

(module
  ;; PREV:      (type $0 (func (result anyref)))

  ;; PREV:      (type $1 (func (result i32)))

  ;; PREV:      (type $2 (func (result (ref any))))

  ;; PREV:      (import "a" "b" (func $get-i32 (type $1) (result i32)))
  ;; LAST:      (type $0 (func (result anyref)))

  ;; LAST:      (type $1 (func (result i32)))

  ;; LAST:      (type $2 (func (result (ref any))))

  ;; LAST:      (import "a" "b" (func $get-i32 (type $1) (result i32)))
  (import "a" "b" (func $get-i32 (result i32)))
  ;; PREV:      (import "a" "c" (func $get-null (type $0) (result anyref)))
  ;; LAST:      (import "a" "c" (func $get-null (type $0) (result anyref)))
  (import "a" "c" (func $get-null (result (ref null any))))
  ;; PREV:      (import "a" "d" (func $get-nonnull (type $2) (result (ref any))))
  ;; LAST:      (import "a" "d" (func $get-nonnull (type $2) (result (ref any))))
  (import "a" "d" (func $get-nonnull (result (ref any))))

  ;; PREV:      (export "test" (func $test))

  ;; PREV:      (func $test (type $0) (result anyref)
  ;; PREV-NEXT:  (local $0 (ref any))
  ;; PREV-NEXT:  (local $1 anyref)
  ;; PREV-NEXT:  (if (result anyref)
  ;; PREV-NEXT:   (call $get-i32)
  ;; PREV-NEXT:   (then
  ;; PREV-NEXT:    (loop $loop
  ;; PREV-NEXT:     (local.set $1
  ;; PREV-NEXT:      (call $get-null)
  ;; PREV-NEXT:     )
  ;; PREV-NEXT:     (br_if $loop
  ;; PREV-NEXT:      (call $get-i32)
  ;; PREV-NEXT:     )
  ;; PREV-NEXT:    )
  ;; PREV-NEXT:    (local.get $1)
  ;; PREV-NEXT:   )
  ;; PREV-NEXT:   (else
  ;; PREV-NEXT:    (local.set $0
  ;; PREV-NEXT:     (call $get-nonnull)
  ;; PREV-NEXT:    )
  ;; PREV-NEXT:    (loop $loop0
  ;; PREV-NEXT:     (if
  ;; PREV-NEXT:      (i32.eqz
  ;; PREV-NEXT:       (call $get-i32)
  ;; PREV-NEXT:      )
  ;; PREV-NEXT:      (then
  ;; PREV-NEXT:       (local.set $0
  ;; PREV-NEXT:        (call $get-nonnull)
  ;; PREV-NEXT:       )
  ;; PREV-NEXT:       (br $loop0)
  ;; PREV-NEXT:      )
  ;; PREV-NEXT:     )
  ;; PREV-NEXT:    )
  ;; PREV-NEXT:    (local.get $0)
  ;; PREV-NEXT:   )
  ;; PREV-NEXT:  )
  ;; PREV-NEXT: )
  ;; LAST:      (export "test" (func $test))

  ;; LAST:      (func $test (type $0) (result anyref)
  ;; LAST-NEXT:  (local $0 anyref)
  ;; LAST-NEXT:  (if (result anyref)
  ;; LAST-NEXT:   (call $get-i32)
  ;; LAST-NEXT:   (then
  ;; LAST-NEXT:    (loop $loop
  ;; LAST-NEXT:     (local.set $0
  ;; LAST-NEXT:      (call $get-null)
  ;; LAST-NEXT:     )
  ;; LAST-NEXT:     (br_if $loop
  ;; LAST-NEXT:      (call $get-i32)
  ;; LAST-NEXT:     )
  ;; LAST-NEXT:    )
  ;; LAST-NEXT:    (local.get $0)
  ;; LAST-NEXT:   )
  ;; LAST-NEXT:   (else
  ;; LAST-NEXT:    (local.set $0
  ;; LAST-NEXT:     (call $get-nonnull)
  ;; LAST-NEXT:    )
  ;; LAST-NEXT:    (loop $loop0
  ;; LAST-NEXT:     (if
  ;; LAST-NEXT:      (i32.eqz
  ;; LAST-NEXT:       (call $get-i32)
  ;; LAST-NEXT:      )
  ;; LAST-NEXT:      (then
  ;; LAST-NEXT:       (local.set $0
  ;; LAST-NEXT:        (call $get-nonnull)
  ;; LAST-NEXT:       )
  ;; LAST-NEXT:       (br $loop0)
  ;; LAST-NEXT:      )
  ;; LAST-NEXT:     )
  ;; LAST-NEXT:    )
  ;; LAST-NEXT:    (local.get $0)
  ;; LAST-NEXT:   )
  ;; LAST-NEXT:  )
  ;; LAST-NEXT: )
  (func $test (export "test")(result (ref null any))
    ;; The locals a and b differ in nullability. After generalization they can
    ;; be coalesced, if we are in LAST.
    (local $a (ref null any))
    (local $b (ref any))
    (if (result (ref null any))
      (call $get-i32)
      (then
        (loop $loop ;; loops to avoid -O2 trivially reducing all this
          (local.set $a
            (call $get-null)
          )
          (br_if $loop
            (call $get-i32)
          )
        )
        (local.get $a)
      )
      (else
        (local.set $b
          (call $get-nonnull)
        )
        (block $out
          (loop $loop ;; loops to avoid -O2 trivially reducing all this
            (br_if $out  ;; early br in loop to keep the local.set outside alive
                         ;; (otherwise it is removed as dead, and the local
                         ;; nullified as part of non-nullable-locals fixups)
              (call $get-i32)
            )
            (local.set $b
              (call $get-nonnull)
            )
            (br $loop)
          )
        )
        (local.get $b)
      )
    )
  )
)
